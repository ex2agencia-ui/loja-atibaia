generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model User {
  id                 String   @id @default(cuid())
  name               String?
  email              String   @unique
  password           String?
  role               UserRole @default(MEMBRO)
  mustChangePassword Boolean  @default(false)
  memberId           String?  @unique
  member             Member?  @relation(fields: [memberId], references: [id])
  comunicadosEnviados Comunicado[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("users")
}

enum UserRole {
  ADMIN
  SECRETARIO
  FINANCEIRO
  CHANCELARIA
  MEMBRO
}

// ─── Members ──────────────────────────────────────────────────────────────────

model Member {
  id                String         @id @default(cuid())
  cim               String         @unique
  situacao          MemberSituacao @default(ATIVO)
  nome              String
  dataNascimento    DateTime?
  posicao           Posicao
  dataIniciacao     DateTime?
  dataElevacao      DateTime?
  dataExaltacao     DateTime?
  dataInstalacao    DateTime?
  dataRegulFiliacao DateTime?

  rua         String?
  numero      String?
  complemento String?
  bairro      String?
  cep         String?
  cidade      String?

  telefone      String?
  isWhatsapp    Boolean @default(false)
  email         String?
  ocupacao      String?
  notasOcupacao String? @db.Text
  empresa       String?
  ramoAtuacao   String?
  site          String?
  linkedin      String?

  conjuge           String?
  nascimentoConjuge DateTime?
  dataCasamento     String?

  filhos         Filho[]
  presencas      Presenca[]
  user           User?
  classificados  Classificado[]
  posts          Post[]
  comentarios    Comentario[]
  reacoes        Reacao[]
  comunicadosRecebidos ComunicadoDestinatario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([situacao])
  @@index([posicao])
  @@map("members")
}

model Filho {
  id             String    @id @default(cuid())
  memberId       String
  nome           String
  dataNascimento DateTime?
  member         Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("filhos")
}

enum MemberSituacao {
  ATIVO
  INATIVO
}

enum Posicao {
  MI
  CM
  MM
  AM
}

// ─── Classificados ────────────────────────────────────────────────────────────

model Classificado {
  id         String                @id @default(cuid())
  memberId   String
  titulo     String
  descricao  String                @db.Text
  categoria  CategoriaClassificado
  contato    String?
  ativo      Boolean               @default(true)
  expiresAt  DateTime?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  member     Member                @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([categoria])
  @@index([ativo])
  @@map("classificados")
}

enum CategoriaClassificado {
  SERVICO
  PRODUTO
  OPORTUNIDADE
  PROCURA
}

// ─── Feed / Posts ─────────────────────────────────────────────────────────────

model Post {
  id          String                 @id @default(cuid())
  memberId    String
  tipo        PostTipo               @default(FEED)
  texto       String                 @db.Text
  imagens     String[]
  titulo      String?
  categoria   CategoriaClassificado?
  contato     String?
  expiresAt   DateTime?
  ativo       Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  member      Member                 @relation(fields: [memberId], references: [id], onDelete: Cascade)
  comentarios Comentario[]
  reacoes     Reacao[]
  comunicado  Comunicado?

  @@index([memberId])
  @@index([tipo])
  @@index([ativo])
  @@index([createdAt])
  @@map("posts")
}

model Comentario {
  id        String   @id @default(cuid())
  postId    String
  memberId  String
  texto     String   @db.Text
  imagens   String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  reacoes   Reacao[]

  @@index([postId])
  @@index([memberId])
  @@map("comentarios")
}

model Reacao {
  id           String      @id @default(cuid())
  emoji        String
  memberId     String
  postId       String?
  comentarioId String?
  createdAt    DateTime    @default(now())
  member       Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  post         Post?       @relation(fields: [postId], references: [id], onDelete: Cascade)
  comentario   Comentario? @relation(fields: [comentarioId], references: [id], onDelete: Cascade)

  @@unique([memberId, postId, emoji])
  @@unique([memberId, comentarioId, emoji])
  @@index([postId])
  @@index([comentarioId])
  @@map("reacoes")
}

enum PostTipo {
  FEED
  CLASSIFICADO
}

// ─── Comunicados ──────────────────────────────────────────────────────────────

model Comunicado {
  id            String                   @id @default(cuid())
  autorId       String
  titulo        String
  texto         String                   @db.Text
  imagens       String[]
  noFeed        Boolean                  @default(false)
  postId        String?                  @unique
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  autor         User                     @relation(fields: [autorId], references: [id])
  post          Post?                    @relation(fields: [postId], references: [id])
  destinatarios ComunicadoDestinatario[]

  @@index([autorId])
  @@index([createdAt])
  @@map("comunicados")
}

model ComunicadoDestinatario {
  id           String     @id @default(cuid())
  comunicadoId String
  memberId     String
  lidoEm       DateTime?
  createdAt    DateTime   @default(now())
  comunicado   Comunicado @relation(fields: [comunicadoId], references: [id], onDelete: Cascade)
  member       Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([comunicadoId, memberId])
  @@index([memberId])
  @@index([comunicadoId])
  @@map("comunicado_destinatarios")
}

// ─── Frases ───────────────────────────────────────────────────────────────────

model Frase {
  id        String   @id @default(cuid())
  texto          String   @db.Text
  autor          String
  descricaoAutor String?  @db.Text
  tema           String
  ativo          Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("frases")
}

// ─── Sessions & Attendance ────────────────────────────────────────────────────

model LojaSession {
  id        String      @id @default(cuid())
  data      DateTime
  descricao String?
  tipo      SessionTipo @default(ORDINARIA)
  fotoUrl   String?
  fotoKey   String?
  presencas Presenca[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([data])
  @@map("loja_sessions")
}

model Presenca {
  id         String         @id @default(cuid())
  memberId   String
  sessionId  String
  status     PresencaStatus @default(F)
  observacao String?
  member     Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  session    LojaSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, sessionId])
  @@index([memberId])
  @@index([sessionId])
  @@map("presencas")
}

enum SessionTipo {
  ORDINARIA
  MAGNA
  ESPECIAL
}

enum PresencaStatus {
  NV
  K
  AB
  SU
  F
  FM
  FR
  BAN
  REP
  IN
  IND
  IP
  EL
  EX
  MI
  MM
  CM
  AM
  P
  REG
  SM
  ZERO
}
